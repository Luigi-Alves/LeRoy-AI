{
  "name": "LeRoy AI Assistant",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "LeRoy AI",
      "onAutoForward": "openBrowser"
    }
  }
}